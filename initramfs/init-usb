#!/bin/sh
# Initramfs init: USB-C port 0 host bring-up report. Prints what the kernel said about the
# SPMI bus, the PD controller, the PHY, the controller and xHCI, then every 15 s the USB
# devices present, for 2 minutes, then reboots to the loader by itself.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
dmesg -n 1
sleep 3
echo
echo "=== USB $(uname -r) ==="
dmesg | grep -i "peek-entry\|usbprep" | cut -c1-170
echo "--- chosen: $(ls /proc/device-tree/chosen | tr "\n" " ")"; [ -f /proc/device-tree/chosen/apple,t6050-usbprep ] && echo "--- usbprep: $(od -An -tx4 /proc/device-tree/chosen/apple,t6050-usbprep | tr -s " \n" " ")"
dmesg | grep -i "hcrst\|xhci_reset\|xhci_halt\|spmi\|tps6598\|sn20120\|tipd\|atcphy\|phy-apple\|dwc3\|xhci\|typec\|usb-pd\|dart.*usb\|2a2f00000\|2a2f80000" | tail -n 24 | cut -c1-170
echo "--- irq: $(grep -i 'xhci\|382280000' /proc/interrupts | tr -s ' ' | cut -c1-80)"
echo "--- hub/dart: $(dmesg | grep -i 'hub\|dart\|fault\|usb 1-\|usb 2-\|port' | grep -v 'input\|rtkit\|keyboard\|multi-touch\|hid\|dockchannel' | tail -n 16 | cut -c1-150 | tr '\n' '|')"
echo "--- drivers bound: spmi $(ls /sys/bus/spmi/devices 2>/dev/null | tr '\n' ' ') | platform $(ls /sys/bus/platform/drivers/dwc3-apple/ /sys/bus/platform/drivers/apple-atcphy/ /sys/bus/platform/drivers/xhci-hcd/ 2>/dev/null | grep -v '^bind\|^unbind\|^uevent\|^module' | tr '\n' ' ')"
for i in $(seq 1 8); do
	echo "usb: up $(cut -d' ' -f1 /proc/uptime) s  irqs $(grep -i 'xhci' /proc/interrupts | awk '{print $2}' | head -1)  devices: $(ls /sys/bus/usb/devices 2>/dev/null | tr '\n' ' ')  $(dmesg | grep -i 'new .*usb device\|product:\|usb-storage\|eth0\|renamed\|rtl8152\|ax88' | tail -n 2 | cut -c1-120 | tr '\n' '|')"
	sleep 15
done
echo "usb: test over, rebooting to the loader"; sleep 2
reboot -f
setsid cttyhack /bin/sh
