#!/bin/sh
# Initramfs init: do nothing but sit. Prints the uptime every 15 s for 10 minutes, then a shell.
# No disk access, no reboot: shows whether the 179 s reset needs the disk root and systemd.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
dmesg -n 1
sleep 3
clear; echo; echo; echo; echo
echo "=== SIT $(uname -r): nvme $(grep -c nvme /proc/partitions) partitions ==="
for i in $(seq 1 40); do
	echo "sit: up $(cut -d' ' -f1 /proc/uptime) s"
	sleep 15
done
setsid cttyhack /bin/sh
