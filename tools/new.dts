		watchdog@28836c000 {
			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
			reg = <0x02 0x8836c000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x2d1 0x04>;
		};

		gpio@29c000000 {
			compatible = "apple,t6050-gpio", "apple,t8103-gpio";
			reg = <0x02 0x9c000000 0x00 0x44000>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x1e6 0x04 0x00 0x1e7 0x04 0x00 0x1e8 0x04 0x00 0x1e9 0x04 0x00 0x1ea 0x04 0x00 0x1eb 0x04 0x00 0x1ec 0x04>;
			status = "disabled";
		};

		mtp@294600000 {
			compatible = "apple,t6050-mtp", "apple,t8142-rtk-helper-asc4", "apple,mtp", "apple,rtk-helper-asc4";
			reg = <0x02 0x94600000 0x00 0x4000 0x02 0x94c00000 0x00 0x100000>;
			reg-names = "asc", "sram";
			mboxes = <0x5c>;
			iommus = <0x5d 0x00>;
			status = "okay";
			phandle = <0x5f>;
		};

		mailbox@294608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0x94608000 0x00 0x4000>;
			interrupts = <0x00 0x2a4 0x04 0x00 0x2a5 0x04 0x00 0x2a6 0x04 0x00 0x2a7 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			status = "okay";
			phandle = <0x5c>;
		};

		iommu@294800000 {
			compatible = "apple,t6050-dart", "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x02 0x94800000 0x00 0xc000>;
			interrupts = <0x00 0x293 0x04>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x00 0x2000000 0x00 0x10000000>;
			status = "okay";
			phandle = <0x5d>;
		};

		fifo@294b14000 {
			compatible = "apple,t6050-dockchannel", "apple,dockchannel";
			reg = <0x02 0x94b14000 0x00 0x1000>;
			reg-names = "irq";
			interrupts = <0x00 0x294 0x04>;
			ranges = <0x00 0x02 0x94b28000 0x20000>;
			nonposted-mmio;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			status = "okay";
			phandle = <0x5e>;

			input@8000 {
				compatible = "apple,dockchannel-hid";
				reg = <0x8000 0x1000 0xc000 0x1000 0x00 0x1000 0x4000 0x1000>;
				reg-names = "config", "data", "rmt-config", "rmt-data";
				iommus = <0x5d 0x00>;
				interrupt-parent = <0x5e>;
				interrupts = <0x02 0x04 0x03 0x04>;
				interrupt-names = "tx", "rx";
				apple,fifo-size = <0x800>;
				apple,helper-cpu = <0x5f>;

				multi-touch {
				};

				keyboard {
					hid-country-code = <0x00>;
					apple,keyboard-layout-id = <0x00>;
				};

				stm {
				};

				actuator {
				};

				tp_accel {
				};
			};
		};

		mailbox@419608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x04 0x19608000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x543 0x04 0x00 0x544 0x04 0x00 0x545 0x04 0x00 0x546 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			power-domains = <0x30>;
			#mbox-cells = <0x00>;
			phandle = <0x60>;
		};

		iommu@41dc50000 {
			compatible = "apple,t6050-sart";
			reg = <0x04 0x1dc50000 0x00 0xc000>;
			power-domains = <0x30>;
			phandle = <0x61>;
		};

		nvme@45dcc0000 {
			compatible = "apple,t6050-nvme-ans2", "apple,t8140-nvme-ans2";
			reg = <0x04 0x5dcc0000 0x00 0x30000 0x04 0x19600000 0x00 0x4000 0x04 0x1dcc0000 0x00 0x60010>;
			reg-names = "nvme", "ans", "nvmmu";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x922 0x04>;
			mboxes = <0x60>;
			apple,sart = <0x61>;
			power-domains = <0x30 0x33 0x39>;
			power-domain-names = "ans", "apcie0", "apcie_phy";
			resets = <0x30>;
		};
	};

	aliases {
		keyboard = "/soc/fifo@294b14000/input@8000/keyboard";
		serial0 = "/soc/serial@505200000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:1500000n8";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "okay";
			power-domains = <0x62>;
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x00 0x00>;
	};
};
