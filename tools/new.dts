/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "apple,j714c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5 Max, 18 CPU cores)";
	interrupt-parent = <0x01>;

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};

				core4 {
					cpu = <0x06>;
				};

				core5 {
					cpu = <0x07>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core3 {
					cpu = <0x0b>;
				};

				core4 {
					cpu = <0x0c>;
				};

				core5 {
					cpu = <0x0d>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};

				core4 {
					cpu = <0x12>;
				};

				core5 {
					cpu = <0x13>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x02>;
		};

		cpu@1 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x03>;
		};

		cpu@2 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x04>;
		};

		cpu@3 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x05>;
		};

		cpu@4 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x04>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x06>;
		};

		cpu@5 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x05>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			phandle = <0x07>;
		};

		cpu@100 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x08>;
		};

		cpu@101 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x09>;
		};

		cpu@102 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x0a>;
		};

		cpu@103 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x0b>;
		};

		cpu@104 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x104>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x0c>;
		};

		cpu@105 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x105>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x15>;
			phandle = <0x0d>;
		};

		cpu@200 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x200>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x0e>;
		};

		cpu@201 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x201>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x0f>;
		};

		cpu@202 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x202>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x10>;
		};

		cpu@203 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x203>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x11>;
		};

		cpu@204 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x204>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x12>;
		};

		cpu@205 {
			compatible = "apple,sotra";
			device_type = "cpu";
			reg = <0x00 0x205>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x16>;
			phandle = <0x13>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x14>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x15>;
		};

		l2-cache-2 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x16>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04 0x01 0x00 0x04 0x01 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x17>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		interrupt-controller@280400000 {
			compatible = "apple,t6050-aic3", "apple,t8142-aic3", "apple,t8122-aic3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			reg = <0x02 0x80400000 0x00 0x1cc000 0x02 0x80440000 0x00 0x4000>;
			reg-names = "core", "event";
			phandle = <0x01>;
		};

		serial@505200000 {
			compatible = "apple,s5l-uart";
			reg = <0x05 0x5200000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x54f 0x04>;
			clocks = <0x17 0x17>;
			clock-names = "uart", "clk_uart_baud0";
		};

		power-management@280600000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x02 0x80600000 0x00 0x4000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			power-controller@108 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x108 0x04>;
				label = "aic";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@110 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x110 0x04>;
				label = "pmc";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@118 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x118 0x04>;
				label = "pms_c1ppt";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@120 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x120 0x04>;
				label = "soc_dpe";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@128 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x128 0x04>;
				label = "pmp";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@130 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x130 0x04>;
				label = "pms_sram";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@138 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x138 0x04>;
				label = "pmgr_soc_ocla";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			power-controller@140 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x140 0x04>;
				label = "b2b_ctrl_nogate";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@148 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x148 0x04>;
				label = "fab0_acc_0";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@150 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x150 0x04>;
				label = "fab0_acc_1";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@158 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x158 0x04>;
				label = "fab2_acc";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@160 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x160 0x04>;
				label = "fab1_acc";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
			};

			power-controller@168 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x168 0x04>;
				label = "b2bc_afc_0";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				phandle = <0x18>;
			};

			power-controller@170 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x170 0x04>;
				label = "b2bc_afc_0_dfx";
				#power-domain-cells = <0x00>;
				power-domains = <0x18>;
				#reset-cells = <0x00>;
			};

			power-controller@178 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x178 0x04>;
				label = "b2bc_afc_1";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				phandle = <0x19>;
			};

			power-controller@180 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x180 0x04>;
				label = "b2bc_afc_1_dfx";
				#power-domain-cells = <0x00>;
				power-domains = <0x19>;
				#reset-cells = <0x00>;
			};

			power-controller@1e8 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x1e8 0x04>;
				label = "fab4_soc";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				phandle = <0x1a>;
			};

			power-controller@1f0 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x1f0 0x04>;
				label = "fab5_soc";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				apple,always-on;
				phandle = <0x1b>;
			};

			power-controller@200 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x200 0x04>;
				label = "dispext0_sys";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				phandle = <0x1c>;
			};

			power-controller@208 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x208 0x04>;
				label = "atc0_common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				phandle = <0x1e>;
			};

			power-controller@210 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x210 0x04>;
				label = "atc1_common";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				phandle = <0x1f>;
			};

			power-controller@220 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x220 0x04>;
				label = "dispext2_sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				#reset-cells = <0x00>;
				phandle = <0x20>;
			};

			power-controller@228 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x228 0x04>;
				label = "dispext3_sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				#reset-cells = <0x00>;
				phandle = <0x22>;
			};

			power-controller@230 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x230 0x04>;
				label = "dispext1_sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x1b>;
				#reset-cells = <0x00>;
				phandle = <0x24>;
			};

			power-controller@238 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x238 0x04>;
				label = "atc2_common";
				#power-domain-cells = <0x00>;
				power-domains = <0x1b>;
				#reset-cells = <0x00>;
				phandle = <0x26>;
			};

			power-controller@240 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x240 0x04>;
				label = "atc3_common";
				#power-domain-cells = <0x00>;
				power-domains = <0x1b>;
				#reset-cells = <0x00>;
				phandle = <0x27>;
			};

			power-controller@248 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x248 0x04>;
				label = "auss";
				#power-domain-cells = <0x00>;
				power-domains = <0x1b>;
				#reset-cells = <0x00>;
				phandle = <0x29>;
			};

			power-controller@250 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x250 0x04>;
				label = "gpio";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			power-controller@258 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x258 0x04>;
				label = "msg";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			power-controller@260 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x260 0x04>;
				label = "ap_tmm";
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
			};

			power-controller@268 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x268 0x04>;
				label = "dispext0_fe";
				#power-domain-cells = <0x00>;
				power-domains = <0x1c>;
				#reset-cells = <0x00>;
				phandle = <0x1d>;
			};

			power-controller@270 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x270 0x04>;
				label = "dispext0_adma";
				#power-domain-cells = <0x00>;
				power-domains = <0x1c>;
				#reset-cells = <0x00>;
			};

			power-controller@278 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x278 0x04>;
				label = "dispext0_cpu";
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				#reset-cells = <0x00>;
				apple,firmware-owned;
			};

			power-controller@280 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x280 0x04>;
				label = "atc0_cio";
				#power-domain-cells = <0x00>;
				power-domains = <0x1e>;
				#reset-cells = <0x00>;
				phandle = <0x28>;
			};

			power-controller@288 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x288 0x04>;
				label = "atc0_pcie";
				#power-domain-cells = <0x00>;
				power-domains = <0x1e>;
				#reset-cells = <0x00>;
			};

			power-controller@290 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x290 0x04>;
				label = "atc1_cio";
				#power-domain-cells = <0x00>;
				power-domains = <0x1f>;
				#reset-cells = <0x00>;
				phandle = <0x2a>;
			};

			power-controller@298 {
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x298 0x04>;
				label = "atc1_pcie";
				#power-domain-cells = <0x00>;
				power-domains = <0x1f>;
				#reset-cells = <0x00>;
			};

			power-controller@2a0 {
